{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Read(~/.config/example/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/bin/status light' blocked"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/bin/status light' active --blink"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alex/bin/git-guard hook pre-bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/bin/status light' completed --auto-reset"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/bin/status light' active --blink"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'exec \"$HOME/bin/statusline\" --env-file /dev/null'"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "example-tools@example-marketplace": true,
    "ralph-loop@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "example-marketplace": {
      "source": {
        "source": "directory",
        "path": "/Users/alex/code/infra/claude-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "theme": "dark-ansi",
  "verbose": false,
  "feedbackSurveyState": {
    "lastShownTime": 1700000000000
  }
}
